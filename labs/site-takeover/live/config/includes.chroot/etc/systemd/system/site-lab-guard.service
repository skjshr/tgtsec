[Unit]
Description=Guard and arm the diskless Site Takeover Lab
After=live-config.service NetworkManager.service
Wants=NetworkManager.service
Before=apache2.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/lab-guard
Restart=on-failure
RestartSec=5
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
