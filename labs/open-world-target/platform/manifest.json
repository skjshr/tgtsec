{
  "schemaVersion": 1,
  "labId": "examserver-open-world-v1",
  "debian": {
    "release": "13",
    "codename": "trixie",
    "architecture": "amd64",
    "filesystem": "btrfs",
    "rootSubvolume": "@"
  },
  "packages": [
    "apache2",
    "btrfs-progs",
    "build-essential",
    "dnsmasq",
    "iproute2",
    "iputils-ping",
    "jq",
    "libapache2-mod-php",
    "network-manager",
    "nfs-kernel-server",
    "nftables",
    "nodejs",
    "openssh-server",
    "python3",
    "rfkill",
    "rsync",
    "samba",
    "sudo",
    "systemd-resolved",
    "wpasupplicant"
  ],
  "network": {
    "targetAddress": "10.13.37.10/24",
    "subnet": "10.13.37.0/24",
    "dnsListenerEnabled": false,
    "advertiseDnsServer": false,
    "allowUpstreamDns": false,
    "dhcpRange": [
      "10.13.37.100",
      "10.13.37.199"
    ],
    "allowedTcpPorts": [
      22,
      80,
      445,
      2049,
      8787
    ],
    "allowedUdpPorts": [
      67
    ],
    "allowDefaultRoute": false,
    "allowExternalDnsServers": false,
    "allowIpv6": false
  },
  "services": {
    "vulnerable": [
      "apache2.service",
      "nfs-server.service",
      "open-world-root-timer.timer",
      "smbd.service",
      "ssh.service"
    ],
    "exerciseInfrastructure": [
      "dnsmasq.service",
      "open-world-file-watch.service",
      "open-world-nfs-watch.service",
      "open-world-telemetry.service"
    ],
    "maintenanceConnectivity": [
      "NetworkManager.service",
      "systemd-resolved.service",
      "wpa_supplicant.service"
    ]
  },
  "serviceProviders": {
    "NetworkManager.service": {
      "kind": "package",
      "name": "network-manager"
    },
    "apache2.service": {
      "kind": "package",
      "name": "apache2"
    },
    "dnsmasq.service": {
      "kind": "package",
      "name": "dnsmasq",
      "config": "/etc/dnsmasq.d/open-world-lab.conf"
    },
    "nfs-server.service": {
      "kind": "package",
      "name": "nfs-kernel-server"
    },
    "open-world-file-watch.service": {
      "kind": "project",
      "owner": "labs/open-world-target/platform"
    },
    "open-world-nfs-watch.service": {
      "kind": "project",
      "owner": "labs/open-world-target/world"
    },
    "open-world-root-timer.timer": {
      "kind": "project",
      "owner": "labs/open-world-target/world"
    },
    "open-world-telemetry.service": {
      "kind": "project",
      "owner": "labs/open-world-target/telemetry"
    },
    "smbd.service": {
      "kind": "package",
      "name": "samba"
    },
    "ssh.service": {
      "kind": "package",
      "name": "openssh-server"
    },
    "systemd-resolved.service": {
      "kind": "package",
      "name": "systemd-resolved"
    },
    "wpa_supplicant.service": {
      "kind": "package",
      "name": "wpasupplicant"
    }
  },
  "mode": {
    "exerciseConfirmation": "ENTER EXERCISE MODE",
    "maintenanceConfirmation": "ENTER MAINTENANCE MODE",
    "connectivityConfirmation": "ENABLE MAINTENANCE CONNECTIVITY"
  },
  "recovery": {
    "normalConfirmationPrefix": "RESTORE DEBIAN",
    "fullConfirmationPrefix": "RESTORE FULL DISK INCLUDING WINDOWS",
    "mountRoot": "/run/open-world-recovery"
  },
  "installFiles": [
    {
      "source": "templates/etc/NetworkManager/conf.d/90-open-world-maintenance.conf",
      "target": "/etc/NetworkManager/conf.d/90-open-world-maintenance.conf",
      "mode": "0644",
      "template": true
    },
    {
      "source": "templates/etc/default/grub.d/90-open-world-root.cfg",
      "target": "/etc/default/grub.d/90-open-world-root.cfg",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/dnsmasq.d/open-world-lab.conf",
      "target": "/etc/dnsmasq.d/open-world-lab.conf",
      "mode": "0644",
      "template": true
    },
    {
      "source": "templates/etc/nftables.d/open-world-exercise.nft",
      "target": "/etc/nftables.d/open-world-exercise.nft",
      "mode": "0600",
      "template": true
    },
    {
      "source": "templates/etc/nftables.d/open-world-quarantine.nft",
      "target": "/etc/nftables.d/open-world-quarantine.nft",
      "mode": "0600",
      "template": false
    },
    {
      "source": "templates/etc/systemd/system/open-world-exercise.target",
      "target": "/etc/systemd/system/open-world-exercise.target",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/systemd/system/open-world-boot-quarantine.service",
      "target": "/etc/systemd/system/open-world-boot-quarantine.service",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/systemd/system/open-world-maintenance.target",
      "target": "/etc/systemd/system/open-world-maintenance.target",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/systemd/system/open-world-vulnerable.target",
      "target": "/etc/systemd/system/open-world-vulnerable.target",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/systemd/system/open-world-vulnerable-failure.service",
      "target": "/etc/systemd/system/open-world-vulnerable-failure.service",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/systemd/system/dnsmasq.service.d/90-open-world-target.conf",
      "target": "/etc/systemd/system/dnsmasq.service.d/90-open-world-target.conf",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/systemd/system/mnt-windows.mount",
      "target": "/etc/systemd/system/mnt-windows.mount",
      "mode": "0644",
      "template": true
    },
    {
      "source": "templates/etc/systemd/system-preset/00-open-world-lab.preset",
      "target": "/etc/systemd/system-preset/00-open-world-lab.preset",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/sysctl.d/90-open-world-exercise.conf",
      "target": "/etc/sysctl.d/90-open-world-exercise.conf",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/tmpfiles.d/open-world-dnsmasq.conf",
      "target": "/etc/tmpfiles.d/open-world-dnsmasq.conf",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/etc/tmpfiles.d/open-world-windows.conf",
      "target": "/etc/tmpfiles.d/open-world-windows.conf",
      "mode": "0644",
      "template": false
    },
    {
      "source": "templates/usr/local/sbin/open-world-platform",
      "target": "/usr/local/sbin/open-world-platform",
      "mode": "0755",
      "template": false
    }
  ]
}
