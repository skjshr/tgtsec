[Unit]
Description=ExamServer read-only Windows bonus volume
ConditionPathExists=/dev/disk/by-partuuid/{{WINDOWS_PARTUUID}}
PartOf=open-world-vulnerable.target

[Mount]
What=/dev/disk/by-partuuid/{{WINDOWS_PARTUUID}}
Where=/mnt/windows
Type=ntfs3
Options=ro,nosuid,nodev,noexec,uid=0,gid=0,umask=077
TimeoutSec=30
