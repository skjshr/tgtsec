enable open-world-boot-quarantine.service
enable open-world-maintenance.target
disable open-world-exercise.target
disable open-world-vulnerable.target
disable open-world-vulnerable-failure.service
disable apache2.service
disable auditd.service
disable dnsmasq.service
disable nfs-server.service
disable open-world-nfs-watch.service
disable open-world-file-watch.service
disable open-world-root-timer.timer
disable open-world-telemetry.service
disable open-world-telemetry.socket
disable rpcbind.service
disable rpcbind.socket
disable rpc-statd.service
disable rpc-statd-notify.service
disable nmbd.service
disable smbd.service
disable ssh.service
disable NetworkManager.service
disable systemd-resolved.service
disable systemd-networkd.service
disable systemd-journald-audit.socket
disable wpa_supplicant.service
