{
  "version": 1,
  "basePath": "/api/session",
  "publicCategories": [
    "Web",
    "共有",
    "整備",
    "権限獲得",
    "権限昇格",
    "root経路",
    "最終地点"
  ],
  "authentication": {
    "scheme": "Bearer",
    "targetEnvironmentVariable": "TELEMETRY_BRIDGE_TOKEN",
    "kaliEnvironmentVariable": "BRIDGE_TARGET_TOKEN",
    "requiredFor": [
      "state",
      "events",
      "selectHypothesis",
      "unlockHint",
      "applyGuidance"
    ],
    "failure": {
      "status": 401,
      "code": "unauthorized",
      "secretEcho": false
    }
  },
  "state": {
    "method": "GET",
    "path": "/api/session/state",
    "response": {
      "experience": "live",
      "sessionId": "exercise-2026-07-27-a",
      "status": "active",
      "revision": 0,
      "facts": [],
      "hypotheses": [
        {
          "id": "hyp-service-inventory",
          "label": "まず、直結先で応答するサービスを整理する",
          "summary": "入口を決める前に、見えている面を事実として並べる。",
          "selected": true,
          "available": true
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "map-01",
            "state": "undiscovered",
            "category": "Web"
          },
          {
            "id": "map-02",
            "state": "undiscovered",
            "category": "共有"
          },
          {
            "id": "map-03",
            "state": "undiscovered",
            "category": "整備"
          }
        ],
        "edges": []
      },
      "hints": [
        {
          "id": "hyp-service-inventory:1",
          "step": 1,
          "title": "確かめること",
          "state": "unlocked",
          "body": "Kali側の有線IPと、10.13.37.10が応答するTCPサービスを見る。"
        },
        {
          "id": "hyp-service-inventory:2",
          "step": 2,
          "title": "使う道具",
          "state": "unlocked",
          "body": "ip addr、ping、nmapの順で、接続とサービスを分けて確認する。"
        },
        {
          "id": "hyp-service-inventory:3",
          "step": 3,
          "title": "組み立て方",
          "state": "unlocked",
          "body": "対象IPを固定し、名前解決やping応答に依存せずサービス版を確認する。"
        },
        {
          "id": "hyp-service-inventory:4",
          "step": 4,
          "title": "操作例",
          "state": "unlocked",
          "body": "nmap -sV -Pn 10.13.37.10"
        }
      ],
      "guidance": {
        "showNextChoices": true,
        "showToolNames": true,
        "showCommandSyntax": true,
        "showCommandExamples": true,
        "explainNoProgress": true,
        "explanationDepth": "full",
        "silhouetteDepth": 1
      },
      "progress": {
        "discovered": 0,
        "total": 13
      },
      "recentEvents": [],
      "telemetry": {
        "status": "live"
      },
      "capabilities": {
        "manualFlagSubmission": false
      }
    }
  },
  "events": {
    "method": "GET",
    "path": "/api/session/events",
    "contentType": "text/event-stream",
    "event": "state",
    "id": "projection.revision",
    "data": "same shape as GET /api/session/state",
    "reconnect": "Last-Event-ID is accepted and every connection receives a full state snapshot"
  },
  "detectorStatusControl": {
    "publicEndpoint": false,
    "unavailableSignal": "SIGUSR1",
    "liveSignal": "SIGUSR2",
    "helper": "/usr/local/sbin/open-world-telemetry-status",
    "meaning": "switch automatic detector availability while this daemon and HTTP API remain alive"
  },
  "selectHypothesis": {
    "method": "POST",
    "path": "/api/session/hypotheses/{hypothesisId}/select",
    "body": {},
    "response": "state projection"
  },
  "unlockHint": {
    "method": "POST",
    "path": "/api/session/hints/{hintId}/unlock",
    "body": {},
    "response": "state projection"
  },
  "applyGuidance": {
    "method": "POST",
    "path": "/api/session/guidance/{commandId}/apply",
    "body": {},
    "commands": [
      "preset.easy",
      "preset.normal",
      "preset.hard",
      "{booleanField}.on",
      "{booleanField}.off",
      "explanationDepth.brief",
      "explanationDepth.full",
      "silhouetteDepth.0",
      "silhouetteDepth.1"
    ],
    "response": "state projection"
  }
}
